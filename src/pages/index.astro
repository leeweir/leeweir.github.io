---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import Pagination from '../components/Pagination.astro';
import { getPosts, PAGE_SIZE } from '../lib/posts';
const posts = await getPosts();
const tags = new Set(posts.flatMap((post) => post.data.tags));
---
<BaseLayout>
  <header class="page-header">
    <p class="eyebrow">WEIR'S NOTE / 技术与思考</p>
    <h1>凡我不能创造的，我就不能理解。</h1>
    <p class="muted">—— 理查德·费曼</p>
  </header>
  <div class="section-heading">
    <h2>文章</h2>
    <span class="muted">{posts.length} 篇笔记 · {tags.size} 个标签</span>
  </div>
  <PostList posts={posts.slice(0, PAGE_SIZE)} />
  <Pagination current={1} total={Math.ceil(posts.length / PAGE_SIZE)} base="/" />
</BaseLayout>
