---
import BaseLayout from '../layouts/BaseLayout.astro';
import { quotes } from '../lib/quotes';
const initialQuote = quotes[0];
---
<BaseLayout landing description="Weir 的个人博客，记录 Linux、网络与云原生技术。">
  <script slot="head" is:inline>
    // Select the comparison font before first paint; preload only that font.
    {
      const font = new URLSearchParams(location.search).get('font') === 'fangsong' ? 'fangsong' : 'wenkai';
      document.documentElement.dataset.quoteFont = font;
      const preload = document.createElement('link');
      preload.rel = 'preload';
      preload.href = `/fonts/quote-${font}.woff2`;
      preload.as = 'font';
      preload.type = 'font/woff2';
      preload.crossOrigin = 'anonymous';
      document.head.append(preload);
    }
  </script>
  <figure class="landing-quote">
    <blockquote id="landing-quote" cite={initialQuote.source}>
      <h1 id="quote-text">{initialQuote.text}</h1>
    </blockquote>
    <figcaption id="quote-author">—— {initialQuote.author}</figcaption>
  </figure>
  <a class="landing-blog" href="/blog/" aria-label="进入文章列表">
    <svg width="32" height="24" viewBox="0 0 32 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M4 12h24M20 4l8 8-8 8" />
    </svg>
  </a>
  <script>
    import { quotes } from '../lib/quotes';

    const previousIndex = quotes.findIndex((quote) => quote.text === history.state?.landingQuote);
    let index = Math.floor(Math.random() * (quotes.length - (previousIndex >= 0 ? 1 : 0)));
    if (previousIndex >= 0 && index >= previousIndex) index += 1;
    // Explicit preview links show the same quote in both typefaces.
    // Normal visits keep the existing random, non-repeating selection.
    const params = new URLSearchParams(location.search);
    if (params.get('font') === 'wenkai' || params.get('font') === 'fangsong') {
      const requestedQuote = Number(params.get('quote'));
      index = Number.isInteger(requestedQuote) && requestedQuote >= 1 && requestedQuote <= quotes.length
        ? requestedQuote - 1
        : 6;
    }
    const quote = quotes[index];
    document.getElementById('quote-text')!.textContent = quote.text;
    document.getElementById('quote-author')!.textContent = `—— ${quote.author}`;
    document.getElementById('landing-quote')!.setAttribute('cite', quote.source);
    history.replaceState({ ...history.state, landingQuote: quote.text }, '');
  </script>
</BaseLayout>

<style>
  @font-face {
    font-family: "Weir Quote Wenkai";
    src: url('/fonts/quote-wenkai.woff2') format('woff2');
    font-style: normal;
    font-weight: 400;
    font-display: swap;
  }

  @font-face {
    font-family: "Weir Quote Fangsong";
    src: url('/fonts/quote-fangsong.woff2') format('woff2');
    font-style: normal;
    font-weight: 400;
    font-display: swap;
  }

  :global(body.landing-page) {
    min-height: 100svh;
  }

  :global(.landing-content) {
    --landing-space: clamp(1rem, 2vw, 1.5rem);
    display: grid;
    grid-template-rows: minmax(min-content, 1fr) auto;
    gap: 2rem;
    min-height: 100vh;
    min-height: 100svh;
    padding: var(--landing-space);
    padding-top: max(var(--landing-space), env(safe-area-inset-top));
    padding-right: max(var(--landing-space), env(safe-area-inset-right));
    padding-bottom: max(var(--landing-space), env(safe-area-inset-bottom));
    padding-left: max(var(--landing-space), env(safe-area-inset-left));
  }

  .landing-quote {
    --quote-font: "Weir Quote Wenkai", "Kaiti SC", "STKaiti", "KaiTi", serif;
    align-self: center;
    justify-self: center;
    max-width: 100%;
    margin: 0;
    width: min(100%, 56rem);
    text-align: center;
  }

  :global(html[data-quote-font="fangsong"]) .landing-quote {
    --quote-font: "Weir Quote Fangsong", "STFangsong", "FangSong", serif;
  }

  .landing-quote blockquote {
    margin: 0;
  }

  .landing-quote h1 {
    margin: 0;
    font-family: var(--quote-font);
    font-size: clamp(1.65rem, min(3.4vw, 7vh), 3rem);
    font-weight: 400;
    line-height: 1.8;
    letter-spacing: 0.015em;
    line-break: strict;
    text-wrap: balance;
  }

  .landing-quote figcaption {
    margin-top: clamp(1.5rem, 3vw, 2rem);
    color: var(--muted);
    font-family: var(--quote-font);
    font-size: 0.9375rem;
    letter-spacing: 0.04em;
  }

  .landing-blog {
    justify-self: end;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    color: var(--accent);
    text-decoration: none;
  }

  .landing-blog:hover {
    color: var(--ink);
    text-decoration: none;
  }
</style>
