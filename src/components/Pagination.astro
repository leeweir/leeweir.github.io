---
interface Props {
  current: number;
  total: number;
  base: string;
}

const { current, total, base } = Astro.props;
const basePath = base.endsWith('/') ? base : `${base}/`;
const pageUrl = (page: number) => (page === 1 ? basePath : `${basePath}page/${page}/`);
---

{
  total > 1 && (
    <nav class="pagination" aria-label="文章分页">
      {current > 1 ? (
        <a class="pagination-direction" href={pageUrl(current - 1)} rel="prev">
          <span aria-hidden="true">←</span> 上一页
        </a>
      ) : (
        <span class="pagination-direction pagination-disabled" aria-disabled="true">
          <span aria-hidden="true">←</span> 上一页
        </span>
      )}
      <ol class="pagination-pages">
        {Array.from({ length: total }, (_, index) => index + 1).map((page) => (
          <li>
            <a
              href={pageUrl(page)}
              aria-label={`第 ${page} 页`}
              aria-current={page === current ? 'page' : undefined}
            >
              {page}
            </a>
          </li>
        ))}
      </ol>
      {current < total ? (
        <a class="pagination-direction" href={pageUrl(current + 1)} rel="next">
          下一页 <span aria-hidden="true">→</span>
        </a>
      ) : (
        <span class="pagination-direction pagination-disabled" aria-disabled="true">
          下一页 <span aria-hidden="true">→</span>
        </span>
      )}
    </nav>
  )
}
